{
    "name": "BelleBitt-Launcher",
    "productName": "BelleBit Launcher",
    "version": "2.0.21",
    "description": "Launcher Minecraft pour le serveur BelleBitt",
    "main": "src/app.js",
    "author": {
        "name": "luuxis, Miracli Inc.",
        "email": "contact@luuxis.fr",
        "url": "https://github.com/luuxis"
    },
    "url": "https://www.miracli.ch/apero",
    "scripts": {
        "start": "cross-env NODE_ENV=dev electron .",
        "dev": "cross-env DEV_TOOL=open NODE_ENV=dev nodemon --exec \"electron .\"",
        "check": "node scripts/check-js.js",
        "build": "node build.js --obf=true --build=platform",
        "icon": "node build.js --icon=https://raw.githubusercontent.com/Miracli99/Apero-Launcher/refs/heads/master/src/assets/images/icon.png"
    },
    "license": "CCANC",
    "nodemonConfig": {
        "ext": "js,html,css",
        "ignore": "**/test"
    },
    "dependencies": {
        "cross-env-shell": "^7.0.3",
        "electron-updater": "^6.8.9",
        "minecraft-java-core": "^4.2.9",
        "node-bdd": "^2.0.4",
        "node-fetch": "^3.3.2",
        "xml-js": "^1.6.11"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "electron": "^44.0.0",
        "electron-builder": "^26.15.3",
        "javascript-obfuscator": "^5.6.0",
        "jimp": "^1.6.1",
        "nodemon": "^3.1.14",
        "png2icons": "^2.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Miracli99/Apero-Launcher.git"
    }
}
